# PostgreSQL próprio (Docker, VPS, ou managed PostgreSQL).
# Conexão privada: NÃO use NEXT_PUBLIC_ para essa variável.
DATABASE_URL=postgresql://foundation:localdevonly@127.0.0.1:5432/foundation

# No deploy, use a URL https real, sem barra final.
BETTER_AUTH_URL=http://localhost:3000

# OBRIGATÓRIO: gere com "openssl rand -base64 32".
BETTER_AUTH_SECRET=
